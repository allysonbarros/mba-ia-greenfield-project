# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object storage (MinIO in dev, S3 in prod)
# STORAGE_ENDPOINT: internal ops endpoint (Compose service name).
# STORAGE_PUBLIC_ENDPOINT: host the presigned URL will be hit from. In-network
#   tests run inside the Compose network, so this is the same minio host; from a
#   browser on the host machine it would be http://localhost:9000.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=streamtube-videos
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true

# Upload / delivery presign windows (seconds) and multipart part size (MiB)
UPLOAD_PART_SIZE_MB=64
UPLOAD_URL_EXPIRES_IN=21600
PLAYBACK_URL_EXPIRES_IN=21600
DOWNLOAD_URL_EXPIRES_IN=900
UPLOAD_STALE_TTL_HOURS=24

# Queue (BullMQ / Redis)
REDIS_HOST=redis
REDIS_PORT=6379
VIDEO_PROCESSING_ATTEMPTS=3
PROCESSING_STUCK_CEILING_HOURS=2
